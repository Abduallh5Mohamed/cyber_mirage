# 🛡️ Environment Variables (Production)
# Copy to .env.production and fill with your values

# ═══════════════════════════════════════════════════════════
# CYBER MIRAGE v5.0 - Production Environment Configuration
# ═══════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# Application Settings
# ───────────────────────────────────────────────────────────
ENVIRONMENT=production
LOG_LEVEL=INFO
AI_MODE=all
HONEYPOT_MODE=production
DEBUG=False

# ───────────────────────────────────────────────────────────
# PostgreSQL Database
# ───────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cyber_mirage
POSTGRES_USER=cybermirage
POSTGRES_PASSWORD=ChangeThisToSecurePassword123!

# Example strong password generation:
# PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Max 256}))
# Linux: openssl rand -base64 32
# Python: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ───────────────────────────────────────────────────────────
# Redis Cache
# ───────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ChangeThisToSecureRedisPass456!

# Example strong password:
# A3@bC5#dE7$fG9&hJ2^kL4!mN6*pQ8w0(Z

# ───────────────────────────────────────────────────────────
# Grafana Monitoring
# ───────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin123
GRAFANA_SECRET=your-random-secret-key-here-change-this

# ───────────────────────────────────────────────────────────
# OSINT API Keys (Optional - Highly Recommended)
# ───────────────────────────────────────────────────────────

# VirusTotal API Key
# Get from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB API Key
# Get from: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# Shodan API Key
# Get from: https://account.shodan.io/
SHODAN_API_KEY=

# ───────────────────────────────────────────────────────────
# Email Alerting (Optional)
# ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=alerts@cyber-mirage.local
ALERT_EMAIL=security@your-company.com

# ───────────────────────────────────────────────────────────
# AI Engine Configuration
# ───────────────────────────────────────────────────────────
AI_ENGINE_HOST=ai-engine
AI_ENGINE_PORT=8001
NEURAL_MODEL_PATH=/app/models/neural
SWARM_AGENTS_COUNT=2100

# ───────────────────────────────────────────────────────────
# Honeypot Configuration
# ───────────────────────────────────────────────────────────
HONEYPOT_SSH_PORT=2222
HONEYPOT_FTP_PORT=2121
HONEYPOT_HTTP_PORT=8080
HONEYPOT_HTTPS_PORT=8443

# ───────────────────────────────────────────────────────────
# Dashboard Settings
# ───────────────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ───────────────────────────────────────────────────────────
# Monitoring & Metrics
# ───────────────────────────────────────────────────────────
PROMETHEUS_RETENTION_DAYS=30
GRAFANA_INSTALL_PLUGINS=grafana-piechart-panel,grafana-worldmap-panel

# ───────────────────────────────────────────────────────────
# Rate Limiting
# ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ───────────────────────────────────────────────────────────
# Model Configuration
# ───────────────────────────────────────────────────────────
MODEL_PATH=data/models/q_table.pkl

# ───────────────────────────────────────────────────────────
# Performance Tuning
# ───────────────────────────────────────────────────────────
UVICORN_WORKERS=1
MAX_CONCURRENT_REQUESTS=100

# ═══════════════════════════════════════════════════════════
# SECURITY RECOMMENDATIONS
# ═══════════════════════════════════════════════════════════
# 
# ✅ DO:
#   • Use passwords with 16+ characters minimum
#   • Mix uppercase, lowercase, numbers, special chars (@#$%^&*)
#   • Use unique, random passwords for each service
#   • Rotate passwords every 90 days in production
#   • Store .env.production in secure, encrypted storage
#   • Never commit .env files to version control
#   • Use secrets management (HashiCorp Vault, AWS Secrets Manager)
#   • Restrict file permissions: chmod 600 .env.production
#
# ❌ DON'T:
#   • Use default passwords (admin/admin, root/root)
#   • Commit .env to git/GitHub
#   • Share passwords in emails or chats
#   • Reuse passwords across different services
#   • Use common dictionary words
#   • Use sequential numbers or keyboard patterns
#   • Log sensitive values or passwords
#
# ═══════════════════════════════════════════════════════════
